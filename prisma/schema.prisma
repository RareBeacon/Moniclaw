// MoniClaw — primary data model (v2)
// PostgreSQL · Prisma 6
//
// Conventions:
//  • UUID primary keys across the board
//  • createdAt/updatedAt on all domain entities
//  • Soft deletes (deletedAt) on User, Workspace, Agent, KnowledgeEntry
//  • Every tenant-scoped table carries workspaceId + composite indexes
//  • Referential rules are explicit: tenant data cascades with the tenant;
//    actor references use SetNull so audit/history rows survive deletions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (unpooled) endpoint — used by Prisma CLI (migrate/introspect) so
  // migrations never traverse a connection pooler (e.g. Neon PgBouncer).
  // The Vercel Neon integration injects both vars; for a non-pooled local
  // database, set DATABASE_URL_UNPOOLED to the same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ── Identity (Auth.js) ────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  // Null for OAuth-only accounts.
  passwordHash   String?
  // Incremented on "sign out everywhere"; issued tokens below this
  // version are rejected in getCurrentUser().
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  accounts         Account[]
  sessions         Session[]
  memberships      Membership[]
  approvals        Approval[]            @relation("ApprovalDecider")
  loginEvents      LoginEvent[]
  auditLogs        AuditLog[]            @relation("AuditActor")
  invitationsSent  WorkspaceInvitation[] @relation("InvitationInviter")
  knowledgeEntries KnowledgeEntry[]
  assets           Asset[]

  // Phase 7 · Multi-agent teams
  agentTeamsCreated AgentTeam[]

  // AI Runtime (Phase 3)
  aiProviderConfigsCreated AiProviderConfig[]
  aiSettingsUpdated        AiWorkspaceSettings[]
  promptTemplatesCreated   PromptTemplate[]
  memoryRecordsCreated     MemoryRecord[]
  aiConversations          AiConversation[]
  knowledgeDocsCreated     KnowledgeDocument[]
  aiUsageEvents            AiUsageEvent[]
  workflowDefsCreated      WorkflowDef[]
  workflowRunsCreated      WorkflowRun[]
  apiKeysCreated           ApiKey[]

  // Computer Use Engine (Phase 4)
  browserProfilesCreated BrowserProfile[]
  browserSessions        BrowserSession[]
  browserExecutions      BrowserExecution[]
  browserUploads         BrowserUpload[]

  // Sales Employee (Phase 6)
  salesCompaniesOwned SalesCompany[]     @relation("SalesCompanyOwner")
  salesContactsOwned  SalesContact[]     @relation("SalesContactOwner")
  salesDealsOwned     SalesDeal[]        @relation("SalesDealOwner")
  salesActivities     SalesActivity[]    @relation("SalesActivityAuthor")
  salesCampaigns      SalesCampaign[]    @relation("SalesCampaignCreator")
  salesDrafts         SalesDraft[]       @relation("SalesDraftCreator")
  salesSavedSearches  SalesSavedSearch[] @relation("SalesSearchCreator")

  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String // e.g. "verify:email" | "reset:email" | "magic:email"
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ── Workspaces ────────────────────────────────────────────────────────

enum WorkspacePlan {
  STARTER
  GROWTH
  BUSINESS
  ENTERPRISE
}

// RBAC roles — capabilities are defined in lib/permissions.ts (the single
// source of truth the UI and every server action consult).
enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model Workspace {
  id         String        @id @default(uuid())
  name       String
  slug       String        @unique
  plan       WorkspacePlan @default(STARTER)
  // Branding: a preset from the approved palette (violet | indigo | blue |
  // emerald | amber | rose). Rendered on workspace chrome + invitations.
  brandColor String        @default("violet")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  memberships Membership[]
  invitations WorkspaceInvitation[]
  agents      Agent[]
  agentsRuns  AgentRun[]
  agentTeams  AgentTeam[]
  credentials VaultEntry[]
  knowledge   KnowledgeEntry[]
  assets      Asset[]
  auditLogs   AuditLog[]

  // AI Runtime (Phase 3)
  aiProviderConfigs  AiProviderConfig[]
  aiSettings         AiWorkspaceSettings?
  promptTemplates    PromptTemplate[]
  memoryRecords      MemoryRecord[]
  aiConversations    AiConversation[]
  aiMessages         AiMessage[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiUsageEvents      AiUsageEvent[]
  workflowDefs       WorkflowDef[]
  workflowRuns       WorkflowRun[]
  apiKeys            ApiKey[]
  planApprovals      Approval[]

  // Computer Use Engine (Phase 4)
  browserSettings   BrowserWorkspaceSettings?
  browserPolicy     BrowserPolicy?
  browserProfiles   BrowserProfile[]
  browserSessions   BrowserSession[]
  browserExecutions BrowserExecution[]
  browserBinaries   BrowserBinary[]

  // Sales Employee (Phase 6)
  salesCompanies     SalesCompany[]
  salesContacts      SalesContact[]
  salesPipelines     SalesPipeline[]
  salesDeals         SalesDeal[]
  salesActivities    SalesActivity[]
  salesCampaigns     SalesCampaign[]
  salesDrafts        SalesDraft[]
  salesSavedSearches SalesSavedSearch[]
  salesSettings      SalesWorkspaceSettings?
  emailConnections   EmailConnection[]

  @@index([deletedAt])
  @@map("workspaces")
}

model Membership {
  id          String         @id @default(uuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
  @@map("memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  workspaceId String
  email       String
  role        MembershipRole   @default(MEMBER)
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email, status])
  @@map("workspace_invitations")
}

// ── Agents ────────────────────────────────────────────────────────────

// Autonomy is earned in stages; promotion is explicit and audit-logged.
enum AgentStatus {
  DRAFT
  SHADOW // dry-run against live data; actions simulated
  SUPERVISED // live within tight caps; approvals broad
  AUTONOMOUS // live within policy; approvals threshold-based
  PAUSED
  ARCHIVED // soft-deleted: hidden from lists, retained for evidence
}

enum TriggerType {
  MANUAL
  SCHEDULE // cron expression in `schedule`
  WEBHOOK
  EVENT // e.g. inbox message, CRM change
}

model Agent {
  id              String      @id @default(uuid())
  workspaceId     String
  name            String
  slug            String
  description     String
  category        String?
  status          AgentStatus @default(DRAFT)
  trigger         TriggerType @default(MANUAL)
  schedule        String?
  policy          Json        @default("{}")
  skills          String[]    @default([])
  // ── Phase 5 · AI Workers (all additive; Phase 2 semantics untouched) ──
  workerType      String      @default("general") // general | research | ops
  goal            String? // natural-language objective the worker pursues
  instructions    String? // operator constraints above the worker's own judgment
  toolPolicy      Json        @default("{}") // {allow?: string[], deny?: string[], allowDelegation?: bool}
  budget          Json        @default("{}") // {maxSteps, maxTokens, maxCostMicros, maxDurationMs, maxConcurrentRuns, maxDepth}
  lastScheduledAt DateTime? // last cron dispatch (schedule due-evaluation)
  runCount        Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      AgentRun[]

  // Phase 7 · Multi-agent teams
  teamMemberships AgentTeamMember[]
  ledTeams        AgentTeam[]       @relation("TeamLeader")

  // AI Runtime (Phase 3)
  memoryRecords   MemoryRecord[]
  aiConversations AiConversation[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, deletedAt])
  @@map("agents")
}

// ── Runs & evidence ───────────────────────────────────────────────────

enum RunMode {
  SHADOW
  LIVE
}

enum RunStatus {
  QUEUED
  RUNNING
  NEEDS_APPROVAL
  SUCCEEDED
  FAILED
  CANCELED
}

model AgentRun {
  id            String    @id @default(uuid())
  agentId       String
  workspaceId   String // denormalized for tenant-scoped queries (indexed below)
  mode          RunMode   @default(LIVE)
  status        RunStatus @default(QUEUED)
  triggerSource String    @default("manual")
  creditsUsed   Int       @default(0)
  startedAt     DateTime?
  finishedAt    DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  // ── Phase 5 · run orchestration (all additive) ──
  parentRunId     String?
  depth           Int     @default(0) // delegation nesting; cap from budget
  teamId          String? // Phase 7 — set when dispatched as a team run
  plan            Json? // validated planner decomposition
  progress        Json? // {nextIndex, trace summary} checkpoint for resume
  budgetSnapshot  Json? // resolved budget at dispatch (immutable per run)
  idempotencyKey  String? // deduplicates dispatch (unique with agentId; NULLs allowed)
  output          Json? // worker result (report, citations, artifacts)
  errorClass      String?
  cancelRequested Boolean @default(false)
  tokensUsed      Int     @default(0)
  stepsExecuted   Int     @default(0)

  agent     Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      AgentTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  parent    AgentRun?  @relation("RunDelegation", fields: [parentRunId], references: [id], onDelete: SetNull)
  children  AgentRun[] @relation("RunDelegation")
  events    RunEvent[]
  approvals Approval[]

  // Sales Employee (Phase 6)
  salesResearchRuns SalesCompany[]  @relation("SalesCompanyResearch")
  salesActivities   SalesActivity[] @relation("SalesActivityRun")
  salesDrafts       SalesDraft[]    @relation("SalesDraftRun")

  @@unique([agentId, idempotencyKey], name: "agentRunIdempotency")
  @@index([workspaceId, status, createdAt])
  @@index([agentId, createdAt])
  @@index([parentRunId])
  @@index([teamId])
  @@map("agent_runs")
}

/// Phase 7 — Multi-agent teams. A team is a NAMED, REUSABLE delegation
/// topology: one leader agent + member agents with playbook hints. Running a
/// team dispatches the leader through the exact same orchestrator path as a
/// solo run — with a composed team briefing and the run stamped `teamId`.
/// Delegation itself stays capability-gated (leader.toolPolicy.allowDelegation),
/// depth-capped, budget-shared and cycle-guarded by the Phase 5 engine.
model AgentTeam {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  slug          String
  description   String?
  leaderAgentId String?
  budget        Json? // partial WorkerBudget applied to every team run (override)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leader    Agent?            @relation("TeamLeader", fields: [leaderAgentId], references: [id], onDelete: SetNull)
  members   AgentTeamMember[]
  runs      AgentRun[]
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@map("agent_teams")
}

model AgentTeamMember {
  id         String   @id @default(uuid())
  teamId     String
  agentId    String
  promptHint String? // short playbook note surfaced to the leader in the briefing
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  team  AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([teamId, agentId])
  @@index([agentId])
  @@map("agent_team_members")
}

model RunEvent {
  id      String   @id @default(uuid())
  runId   String
  ts      DateTime @default(now())
  // e.g. browser_action | api_call | note | approval | screenshot | error
  type    String
  message String
  payload Json     @default("{}")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, ts])
  @@map("run_events")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

model Approval {
  id          String         @id @default(uuid())
  // Run-derived approvals link to an AgentRun; plan-derived approvals
  // (Phase 3 planner) link straight to the workspace instead. One of the
  // two is always set (enforced by the creating service).
  runId       String?
  workspaceId String?
  actionType  String
  amountUsd   Decimal?       @db.Decimal(12, 2)
  detail      Json           @default("{}")
  requestedTo String
  status      ApprovalStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime       @default(now())

  run       AgentRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decidedBy User?      @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // Sales Employee (Phase 6)
  salesDrafts SalesDraft[] @relation("SalesDraftApproval")

  @@index([status, createdAt])
  @@index([workspaceId, status, createdAt])
  @@map("approvals")
}

// ── Credential vault (references only — ciphertext lives in the vault service) ──

model VaultEntry {
  id          String    @id @default(uuid())
  workspaceId String
  label       String
  domain      String
  scopes      String[]  @default([])
  // Pointer to the sealed secret in the vault service — never the secret itself.
  secretRef   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rotatedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain, label])
  @@map("vault_entries")
}

// ── Knowledge base ────────────────────────────────────────────────────

model KnowledgeEntry {
  id          String    @id @default(uuid())
  workspaceId String
  title       String
  body        String    @db.Text
  tags        String[]  @default([])
  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, deletedAt, updatedAt])
  @@map("knowledge_entries")
}

// ── File assets ───────────────────────────────────────────────────────

enum AssetKind {
  AVATAR
  EXPORT
  RUN_EVIDENCE
  DOCUMENT
}

model Asset {
  id          String    @id @default(uuid())
  workspaceId String?
  kind        AssetKind
  name        String
  mimeType    String
  sizeBytes   Int
  // Small object storage (≤ 512 KB enforced at write time): avatars and
  // CSV exports. Larger artifacts move to object storage via storageRef
  // when the bucket integration is configured.
  content     Bytes?
  storageRef  String?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, kind, createdAt])
  @@map("assets")
}

// ── Audit & security telemetry ────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String?
  actorId     String?
  // Namespaced action, e.g. "agent.create" | "member.invite" | "settings.update"
  action      String
  targetType  String?
  targetId    String?
  metadata    Json     @default("{}")
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Phase 9 — durable rate-limit buckets. Fixed-window counters shared across
/// every serverless instance (the in-memory limiter stays as the unit-test
/// store and circuit-breaker fallback). One row per (policy:scope) key;
/// expired rows are reaped by the daily sweep cron.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  provider  String // credentials | google | github
  success   Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@map("login_events")
}

// ═══════════════════════════════════════════════════════════════════════
// AI RUNTIME (Phase 3) — additive only; no changes to existing models.
// ═══════════════════════════════════════════════════════════════════════

/// Providers with shipping adapters first; the rest are registry-ready.
enum AiProviderId {
  GEMINI
  OPENROUTER
  OLLAMA
  OPENAI
  ANTHROPIC
  DEEPSEEK
  MISTRAL
  GROQ
  XAI
  TOGETHER
  CUSTOM // user-supplied OpenAI-compatible endpoint (baseUrl+model required)
}

/// BYOK provider credentials per workspace. API keys are stored encrypted
/// (AES-256-GCM, key derived from AUTH_SECRET) — never plaintext.
model AiProviderConfig {
  id              String       @id @default(uuid())
  workspaceId     String
  provider        AiProviderId
  label           String
  baseUrl         String? // Ollama endpoint / compatible gateways
  apiKeyEnc       String? // ciphertext; NULL for keyless (Ollama)
  enabled         Boolean      @default(true)
  priority        Int          @default(100) // lower = tried earlier
  defaultModel    String?
  healthStatus    String? // "ok" | "error" after last test
  healthCheckedAt DateTime?
  healthError     String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, label])
  @@index([workspaceId, enabled, priority])
  @@map("ai_provider_configs")
}

/// Per-workspace AI tunables: defaults + memory/knowledge/tool limits.
model AiWorkspaceSettings {
  workspaceId              String        @id
  defaultProvider          AiProviderId?
  defaultModel             String        @default("gemini-2.5-flash")
  embeddingModel           String        @default("text-embedding-004")
  memoryMaxRecords         Int           @default(5000)
  memoryRetentionDays      Int           @default(180)
  memorySummarizeAfter     Int           @default(40) // messages before compression
  knowledgeMaxDocuments    Int           @default(200)
  knowledgeMaxFileMB       Int           @default(10)
  knowledgeMaxChunksPerDoc Int           @default(2000)
  toolPermissions          Json          @default("{}") // { toolName: boolean }
  updatedById              String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("ai_workspace_settings")
}

enum PromptKind {
  SYSTEM
  WORKSPACE
  AGENT
  TASK
}

enum PromptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Versioned prompt templates; (templateKey, version) is immutable.
model PromptTemplate {
  id          String       @id @default(uuid())
  workspaceId String
  templateKey String // shared by every version of one template
  name        String
  kind        PromptKind   @default(TASK)
  content     String       @db.Text
  variables   Json         @default("[]") // [{name, description?, default?, required?}]
  version     Int
  status      PromptStatus @default(DRAFT)
  notes       String?
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([templateKey, version])
  @@index([workspaceId, kind, status])
  @@map("prompt_templates")
}

enum MemoryScope {
  CONVERSATION // rolling short-term, tied to conversationKey
  WORKSPACE // shared facts for the whole workspace
  AGENT // per-agent durable facts
  LONG_TERM // promoted/compressed knowledge
}

/// Memory records; vector column enables semantic recall (pgvector, 768-d
/// gemini embeddings — see runtime/embeddings for the model contract).
model MemoryRecord {
  id              String                      @id @default(uuid())
  workspaceId     String
  scope           MemoryScope
  agentId         String?
  conversationKey String? // e.g. AiConversation.id or external thread id
  content         String                      @db.Text
  importance      Int                         @default(50) // 0..100 ranking weight
  tags            String[]                    @default([])
  embedding       Unsupported("vector(768)")?
  embeddingModel  String?
  expiresAt       DateTime? // expiration policy: NULL = keep
  createdById     String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, scope, createdAt])
  @@index([workspaceId, conversationKey])
  @@index([expiresAt])
  @@map("memory_records")
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL
}

model AiConversation {
  id           String   @id @default(uuid())
  workspaceId  String
  userId       String?
  agentId      String?
  title        String   @default("New conversation")
  summary      String?  @db.Text // compressed long-term gist
  messageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent     Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages  AiMessage[]

  @@index([workspaceId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id               String   @id @default(uuid())
  conversationId   String
  workspaceId      String // denormalized for tenant-scoped reads
  role             ChatRole
  content          String   @db.Text
  toolCalls        Json? // [{id,name,arguments,result?}]
  provider         String?
  model            String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  createdAt        DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("ai_messages")
}

enum KnowledgeDocStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum KnowledgeDocSource {
  FILE
  URL
}

model KnowledgeDocument {
  id          String             @id @default(uuid())
  workspaceId String
  title       String
  filename    String
  mime        String
  sizeBytes   Int
  checksum    String // sha256 of content → duplicate detection
  source      KnowledgeDocSource @default(FILE)
  sourceUrl   String?
  status      KnowledgeDocStatus @default(UPLOADED)
  error       String?
  chunkCount  Int                @default(0)
  createdById String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime? // soft delete keeps chunks recoverable

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  chunks    KnowledgeChunk[]

  @@unique([workspaceId, checksum])
  @@index([workspaceId, status, createdAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id          String                      @id @default(uuid())
  documentId  String
  workspaceId String // denormalized for tenant-scoped similarity
  index       Int
  content     String                      @db.Text
  tokenCount  Int
  embedding   Unsupported("vector(768)")?
  createdAt   DateTime                    @default(now())

  document  KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([documentId, index])
  @@index([workspaceId])
  @@map("knowledge_chunks")
}

/// Cross-request embedding cache, keyed by model+text hash (content-derived,
/// tenant-agnostic: identical text yields identical vectors).
model EmbeddingCache {
  hash      String                     @id // sha256(model + ":" + text)
  model     String
  dim       Int
  vector    Unsupported("vector(768)")
  hitCount  Int                        @default(0)
  createdAt DateTime                   @default(now())

  @@index([model])
  @@map("embedding_cache")
}

enum UsageKind {
  CHAT
  EMBEDDING
  TOOL
  WORKFLOW
}

enum UsageStatus {
  OK
  ERROR
}

/// One row per billable AI operation; powers the usage dashboard.
/// costMicros = cost in millionths of a USD (avoids floats).
model AiUsageEvent {
  id               String      @id @default(uuid())
  workspaceId      String
  userId           String?
  kind             UsageKind
  status           UsageStatus @default(OK)
  provider         String
  model            String
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  totalTokens      Int         @default(0)
  latencyMs        Int         @default(0)
  costMicros       BigInt      @default(0)
  toolCallCount    Int         @default(0)
  errorCode        String?
  requestId        String? // caller correlation ("run:<agentRunId>" for worker calls)
  createdAt        DateTime    @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, provider, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@index([workspaceId, requestId])
  @@map("ai_usage_events")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model WorkflowDef {
  id          String         @id @default(uuid())
  workspaceId String
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  version     Int            @default(1)
  definition  Json // {nodes:[{id,type,config,position?}], edges:[{from,to,condition?}]}
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  runs      WorkflowRun[]

  @@index([workspaceId, status, updatedAt])
  @@map("workflow_defs")
}

enum WorkflowRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
  WAITING_APPROVAL
}

model WorkflowRun {
  id            String            @id @default(uuid())
  workflowId    String
  workspaceId   String // denormalized for tenant-scoped reads
  status        WorkflowRunStatus @default(RUNNING)
  input         Json?
  output        Json?
  trace         Json? // [{nodeId,status,startedAt,finishedAt,output?,error?}]
  error         String?
  triggerSource String            @default("manual")
  createdById   String?
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?

  workflow  WorkflowDef @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, startedAt])
  @@index([workflowId, startedAt])
  @@map("workflow_runs")
}

/// Programmatic access for the REST API + SDK. Keys are shown once at
/// creation; only the SHA-256 hash persists. Prefix is a display hint.
model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  name        String
  prefix      String // "msk_" + first 8 chars
  keyHash     String    @unique
  scopes      String[]  @default(["read", "write"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, revokedAt])
  @@map("api_keys")
}

// ══════════════════════════════════════════════════════════════════════════
// Phase 4 — MoniClaw Computer Use Engine (MCUE)
// ══════════════════════════════════════════════════════════════════════════

enum BrowserKind {
  CHROMIUM
  CHROME // google-chrome channel (where installed)
  MSEDGE // microsoft-edge channel (where installed)
  FIREFOX // playwright firefox build (where supported)
}

enum BrowserMode {
  HEADLESS
  HEADED
}

enum BrowserSessionKind {
  EPHEMERAL // destroyed at close (default)
  PERSISTENT // bound to a BrowserProfile (cookies + storage persist)
  INCOGNITO // isolated context, no persistence, cookie writes session-local
}

enum BrowserSessionStatus {
  STARTING
  ACTIVE
  IDLE
  RECOVERING // driver reconnect / context recovery in flight
  CLOSED
  ERROR
  TIMEOUT
}

enum BrowserExecutionStatus {
  QUEUED
  PLANNING
  RUNNING
  VALIDATING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
  AWAITING_APPROVAL // parked on a confirmation-required domain or JS step
}

enum BrowserActionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  RECOVERED // succeeded through a recovery strategy (healed selector etc.)
}

/// Per-workspace engine defaults (edits flow from the Browser Settings page).
model BrowserWorkspaceSettings {
  workspaceId           String      @id
  defaultBrowser        BrowserKind @default(CHROMIUM)
  headless              Boolean     @default(true)
  actionTimeoutMs       Int         @default(30000)
  executionTimeoutMs    Int         @default(120000)
  sessionIdleTimeoutSec Int         @default(600)
  maxConcurrentSessions Int         @default(3)
  dialogPolicy          String      @default("dismiss") // dismiss | accept
  screenshotOnFail      Boolean     @default(true)
  recordScreenshots     Boolean     @default(true)
  maxArtifactMB         Int         @default(25)
  updatedById           String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("browser_workspace_settings")
}

/// Per-workspace permission policy (edits flow from the Permissions page).
/// Domain lists support exact hosts and one-level wildcards (*.example.com);
/// policy evaluation order: blocked > confirmation > allowed > defaultAllowed.
model BrowserPolicy {
  workspaceId         String   @id
  readOnly            Boolean  @default(false) // extraction/capture only
  navigationOnly      Boolean  @default(false) // + navigate family
  allowJavascript     Boolean  @default(false) // execute_js action gate
  allowDownloads      Boolean  @default(true)
  allowUploads        Boolean  @default(true)
  allowClipboard      Boolean  @default(false)
  allowedDomains      String[] @default([])
  blockedDomains      String[] @default([])
  confirmationDomains String[] @default([]) // risky — require human approval
  defaultAllowed      Boolean  @default(true)
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("browser_policies")
}

/// Reusable browser profiles — cookies + web storage encrypted at rest
/// (AES-256-GCM vault, same construction as provider BYOK keys).
model BrowserProfile {
  id              String      @id @default(uuid())
  workspaceId     String
  name            String
  description     String?
  browser         BrowserKind @default(CHROMIUM)
  userAgent       String?
  viewport        Json? // {width, height}
  storageStateEnc String? // encrypted playwright storageState JSON
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sessions  BrowserSession[]

  @@index([workspaceId, deletedAt])
  @@map("browser_profiles")
}

/// Live browser sessions. The driver process itself may be a pooled local
/// browser, a shared remote worker (BROWSER_WS_ENDPOINT), or a serverless
/// ephemeral — `endpoint` records which.
model BrowserSession {
  id             String               @id @default(uuid())
  workspaceId    String
  userId         String?
  profileId      String?
  browser        BrowserKind          @default(CHROMIUM)
  mode           BrowserMode          @default(HEADLESS)
  kind           BrowserSessionKind   @default(EPHEMERAL)
  status         BrowserSessionStatus @default(STARTING)
  endpoint       String? // "local" | ws endpoint of the owning worker
  currentUrl     String?
  currentTitle   String?
  tabCount       Int                  @default(1)
  activeTab      Int                  @default(0)
  lastError      String?
  idleExpiresAt  DateTime?
  lastActivityAt DateTime             @default(now())
  createdById    String?
  createdAt      DateTime             @default(now())
  closedAt       DateTime?

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile    BrowserProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  executions BrowserExecution[]

  @@index([workspaceId, status, lastActivityAt])
  @@map("browser_sessions")
}

/// A unit of computer-use work: goal → planned steps → queue → execute →
/// validate → retry → terminal state. Steps live in `plan` (validated JSON);
/// the audit trail lives in BrowserActionEvent rows.
model BrowserExecution {
  id          String                 @id @default(uuid())
  workspaceId String
  userId      String?
  sessionId   String
  goal        String?
  status      BrowserExecutionStatus @default(QUEUED)
  plan        Json? // [{seq, action, args, selector?}] validated at queue time
  result      Json? // {outputs: {seq: value}, summary?}
  error       String?
  approvalId  String? // parked-approval link (plan/risky domain/JS)
  stepCount   Int                    @default(0)
  failedStep  Int?
  attempts    Int                    @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime               @default(now())

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  session     BrowserSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events      BrowserActionEvent[]
  recording   BrowserRecording?
  downloads   BrowserDownload[]
  screenshots BrowserScreenshot[]

  @@index([workspaceId, status, createdAt])
  @@index([sessionId, createdAt])
  @@map("browser_executions")
}

/// One row per action attempt — the recording trail, the audit log, and the
/// replay source of truth. seq + attempt reproduce the exact timeline.
model BrowserActionEvent {
  id           String              @id @default(uuid())
  executionId  String
  workspaceId  String // denormalized for tenant-scoped reads
  seq          Int
  action       String // action definition id, e.g. "navigate" | "click"
  selector     Json? // normalized SelectorSpec actually used (after healing)
  args         Json?
  status       BrowserActionStatus
  attempt      Int                 @default(1)
  durationMs   Int?
  error        String?
  screenshotId String?
  healedFrom   Json? // original selector when self-healing succeeded
  metadata     Json?
  createdAt    DateTime            @default(now())

  execution BrowserExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, seq, attempt])
  @@index([workspaceId, createdAt])
  @@map("browser_action_events")
}

/// Compact replay metadata per execution (frames reference screenshots).
model BrowserRecording {
  id          String   @id @default(uuid())
  executionId String   @unique
  workspaceId String
  steps       Int      @default(0)
  screenshots Int      @default(0)
  errors      Int      @default(0)
  retries     Int      @default(0)
  durationMs  Int      @default(0)
  timeline    Json // [{seq, action, status, at, durationMs, screenshotId?, url?}]
  createdAt   DateTime @default(now())

  execution BrowserExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("browser_recordings")
}

/// Raw binary store for engine artifacts (screenshots, PDFs, downloads,
/// upload payloads). Capped per workspace settings (default 25MB); the
/// BinaryStore port documents the S3/R2 seam for bucket-backed deployments.
model BrowserBinary {
  id          String   @id @default(uuid())
  workspaceId String
  sha256      String
  mime        String
  sizeBytes   Int
  data        Bytes
  createdAt   DateTime @default(now())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  downloads   BrowserDownload[]
  uploads     BrowserUpload[]
  screenshots BrowserScreenshot[]

  @@index([workspaceId, sha256])
  @@map("browser_binaries")
}

model BrowserDownload {
  id            String   @id @default(uuid())
  workspaceId   String
  sessionId     String?
  executionId   String?
  filename      String
  suggestedName String
  mime          String
  sizeBytes     Int
  sha256        String
  binaryId      String
  scanStatus    String   @default("PENDING") // PENDING | CLEAN | HELD (scanner port)
  scanDetail    String?
  createdAt     DateTime @default(now())

  binary    BrowserBinary     @relation(fields: [binaryId], references: [id], onDelete: Cascade)
  execution BrowserExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("browser_downloads")
}

model BrowserUpload {
  id          String    @id @default(uuid())
  workspaceId String
  uploaderId  String?
  filename    String
  mime        String
  sizeBytes   Int
  sha256      String
  binaryId    String
  usedCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  binary   BrowserBinary @relation(fields: [binaryId], references: [id], onDelete: Cascade)
  uploader User?         @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("browser_uploads")
}

model BrowserScreenshot {
  id          String   @id @default(uuid())
  workspaceId String
  sessionId   String?
  executionId String?
  kind        String   @default("AUTO") // AUTO | MANUAL | FAILURE | STEP
  binaryId    String
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  binary    BrowserBinary     @relation(fields: [binaryId], references: [id], onDelete: Cascade)
  execution BrowserExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("browser_screenshots")
}


# ─────────────────────────────────────────────────────────────
# MoniClaw — environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets. `.env*` files are git-ignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Phase 2 — Prisma / PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/moniclaw?schema=public"
# Direct/unpooled endpoint — used by Prisma CLI for migrations. On Vercel the
# Neon integration injects both vars; locally, mirror DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/moniclaw?schema=public"

# Auth.js / NextAuth (Phase 2)
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Trust the host header — required outside Vercel (local prod builds, Docker, VPS).
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Optional registration access gate (Phase 6) — when set, signup requires
# this code (constant-time compare, no DB work on mismatch). Share it only
# with people allowed to self-register; rotate to reopen/close registration.
# Leave empty to allow open registration.

# Transactional email (Resend HTTP API — used for verification & reset links)
# Without a key, links are printed to the dev server console instead.
RESEND_API_KEY=""
# Transactional mail — configure one transport. SMTP credentials stay server-only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# Exact lowercase email granted platform-owner administration after verification.
PLATFORM_ADMIN_EMAIL=""

EMAIL_FROM="MoniClaw <no-reply@moniclaw.com>"

# ── AI Runtime (Phase 3) — all optional, bring-your-own-key per workspace ──
# Env-level fallbacks apply to every workspace WITHOUT its own key configured
# (workspace keys always take priority). Free tiers are enough to run.
# Google AI Studio key — default chat + embeddings provider (free tier
# ~1,500 req/day — the highest-capacity zero-cost option).
GEMINI_API_KEY=""
# OpenRouter key — first failover; stick to :free models to stay at $0.
# Free keys are capped at 50 free-model requests/day (shared across
# workspaces) — enough for a few research runs/day.
OPENROUTER_API_KEY=""
# Groq key — free tier, very fast llama-3.3-70b (great second free fallback).
GROQ_API_KEY=""
# Self-hosted Ollama — last-resort, keyless.
OLLAMA_BASE_URL="http://localhost:11434"
# Optional paid fallbacks (used only if set; workspaces' own keys win anyway).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
MISTRAL_API_KEY=""
XAI_API_KEY=""
TOGETHER_API_KEY=""

# Cron (Vercel Cron → GET /api/cron/memory-sweep, daily)
# Vercel attaches `Authorization: Bearer $CRON_SECRET` to cron invocations.
CRON_SECRET=""

# Observability (optional)
# SENTRY_DSN=""
# POSTHOG_KEY=""

# ── Computer Use Engine (Phase 4) — all optional; local Chromium by default ──
# Remote browser worker endpoint. When set, sessions open on the worker
# (packages/browser-worker — see docs/DEPLOYMENT.md); required on Vercel.
BROWSER_WS_ENDPOINT=""
# Shared secret between the app and the browser worker (worker refuses to
# boot without one; client sends it on the WebSocket upgrade).
BROWSER_WORKER_TOKEN=""
# Chromium location for local sessions (npm i downloads to ~/.cache/ms-playwright).
PLAYWRIGHT_BROWSERS_PATH=""
# Set to 1 on AWS Lambda-style hosts to launch @sparticuz/chromium instead.
# NOT for Vercel serverless — browsers exceed the bundle/size limits there;
# run the browser worker (or point BROWSER_WS_ENDPOINT elsewhere) instead.
MCUE_SERVERLESS_CHROMIUM=""
# Process pool tuning for local sessions.
MCUE_POOL_MAX_PROCESSES="4"
MCUE_POOL_IDLE_MS="120000"

# AI Workers (Phase 5): concurrent worker runs per process (default 2).
AGENT_QUEUE_CONCURRENCY="2"

# Launch capacity (Phase 9) ────────────────────────────────────────────────
# Hard cap on total registered accounts for the private launch. When the cap
# is reached, registration closes with an honest "at capacity" message.
# Unset / 0 = uncapped (development default). Seats-taken is visible under
# Settings → Access & launch seats.
AUTH_REGISTRATION_MAX_USERS="50"

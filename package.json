{
  "name": "moniclaw",
  "version": "0.1.0",
  "private": true,
  "description": "MoniClaw \u2014 the AI Workforce Operating System. Public website & web app.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "node --import tsx --test tests/permissions.test.ts tests/rate-limit.test.ts tests/validations.test.ts tests/format.test.ts tests/ai-crypto.test.ts tests/ai-expression.test.ts tests/ai-chunker.test.ts tests/ai-prompts.test.ts tests/ai-router.test.ts tests/ai-tools.test.ts tests/ai-workflows.test.ts tests/ai-planner.test.ts tests/ai-usage.test.ts",
    "test:integration": "node --import tsx --test tests/integration/db-runtime.test.ts",
    "test:perf": "node --import tsx --test tests/perf/runtime.perf.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "test:auth": "tsx scripts/auth-flow-test.mts",
    "test:routes": "tsx scripts/dashboard-routes-test.mts",
    "test:flows": "tsx scripts/auth-email-flows-test.mts",
    "test:ai": "tsx scripts/ai-api-e2e-test.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.24",
    "lucide-react": "^0.427.0",
    "mammoth": "^1.12.0",
    "next": "^14.2.15",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.3.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.41",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  },
  "test": "node --import tsx --test tests/permissions.test.ts tests/rate-limit.test.ts tests/validations.test.ts tests/format.test.ts"
}
